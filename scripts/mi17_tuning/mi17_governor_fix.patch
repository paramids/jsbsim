+          <sum>
+            <property> governor/pid-output </property>
+            <product>
+              <property> fcs/collective-cmd-norm </property>
+              <property> governor/collective-feedforward </property>
+            </product>
+          </sum>
           <property> governor/enabled </property>
         </product>
       </function>
